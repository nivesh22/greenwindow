{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "dub1"
  ],
  "git": {
    "deploymentEnabled": {
      "data": false
    }
  },
  "rewrites": [
    {
      "source": "/api/plans",
      "destination": "/api/user/plans"
    },
    {
      "source": "/api/push/subscribe",
      "destination": "/api/user/push-subscribe"
    },
    {
      "source": "/api/reminders",
      "destination": "/api/user/reminders"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
