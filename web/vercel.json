{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "dub1"
  ],
  "git": {
    "deploymentEnabled": {
      "data": false
    }
  },
  "rewrites": [
    {
      "source": "/api/conversations/latest",
      "destination": "/api/conversations?view=latest"
    },
    {
      "source": "/api/plans",
      "destination": "/api/user?route=plans"
    },
    {
      "source": "/api/push/subscribe",
      "destination": "/api/user?route=push-subscribe"
    },
    {
      "source": "/api/reminders",
      "destination": "/api/user?route=reminders"
    },
    {
      "source": "/api/cron/:job",
      "destination": "/api/cron?route=:job"
    },
    {
      "source": "/api/admin/:view",
      "destination": "/api/admin?route=:view"
    },
    {
      "source": "/scheduler",
      "destination": "/scheduler.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/leaderboard.html"
    },
    {
      "source": "/backtest",
      "destination": "/backtest.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/settings",
      "destination": "/app.html"
    },
    {
      "source": "/account",
      "destination": "/app.html"
    },
    {
      "source": "/ops",
      "destination": "/app.html"
    },
    {
      "source": "/ops/:path*",
      "destination": "/app.html"
    }
  ]
}
