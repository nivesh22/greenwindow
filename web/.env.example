# Public URL of the published JSON files (spec 7.6). Not a secret: every VITE_ variable ships in the bundle.
VITE_DATA_BASE_URL=https://raw.githubusercontent.com/nivesh22/greenwindow/data/app_data

# Agent overhaul (docs/agent-execution-plan.md §5). Real values go in web/.env.local (gitignored) and Vercel.
# Server-only (never prefix with VITE_):
GEMINI_API_KEY=
AI_GATEWAY_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
IP_SALT=
# Public by design (shipped in the bundle; RLS protects data):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Bot check before anonymous sessions (P3). Site key is public by design (Vercel type: Config).
VITE_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
