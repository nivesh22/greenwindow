{
  // Server-side agent code (Vercel Functions). Node types, no DOM. Shares only pure src modules.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.agent.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "agent",
    "api",
    "src/scheduler/optimizer.ts",
    "src/lib/time.ts",
    "src/lib/format.ts",
    "src/data/schemas.ts",
    "src/data/parse.ts",
    "src/data/models.ts"
  ]
}
